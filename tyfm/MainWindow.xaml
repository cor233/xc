<Window x:Class="tyfm.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="听友FM下载器" Height="780" Width="1280" MinWidth="1280" MinHeight="720" Background="{StaticResource WindowBg}"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,24,0" VerticalAlignment="Center">
                <TextBlock Text="搜索:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource TextGray}" FontSize="14"/>
                <TextBox x:Name="SearchBox" Width="260" Height="34" />
                <Button x:Name="SearchBtn" Content="搜索" Style="{StaticResource ModernButton}" Margin="8,0,0,0" Height="34"/>
            </StackPanel>
            
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,24,0" VerticalAlignment="Center">
                <TextBlock Text="保存目录:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource TextGray}" FontSize="14"/>
                <TextBox x:Name="FolderBox" Width="300" Height="34" />
                <Button x:Name="BrowseBtn" Content="浏览" Style="{StaticResource ModernButton}" Margin="8,0,0,0" Height="34"/>
            </StackPanel>
            
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="并发:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource TextGray}" FontSize="14"/>
                <TextBox x:Name="ConcurrencyBox" Width="60" Height="34" TextAlignment="Center" Text="1" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource CardBg}" CornerRadius="8" Padding="1">
                <Border.Effect><DropShadowEffect Color="Black" Opacity="0.05" BlurRadius="10" ShadowDepth="2"/></Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Text="搜索结果" FontWeight="Bold" Margin="16,12" FontSize="15"/>
                    
                    <DataGrid x:Name="ResultGrid" Grid.Row="1" Margin="0" 
                              HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="序号" Binding="{Binding Idx}" Width="60">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="书名" Binding="{Binding Title}" Width="400">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="演播" Binding="{Binding Narrator}" Width="130">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    
                    <Border Grid.Row="2" Background="#F9F9F9" BorderBrush="#EEEEEE" BorderThickness="0,1,0,0">
                        <TextBlock x:Name="LeftStatus" Text="就绪" Margin="16,10" Foreground="{StaticResource TextGray}" FontSize="13"/>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource CardBg}" CornerRadius="8" Padding="1">
                <Border.Effect><DropShadowEffect Color="Black" Opacity="0.05" BlurRadius="10" ShadowDepth="2"/></Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12" VerticalAlignment="Center">
                        <TextBlock Text="起始:" VerticalAlignment="Center" Foreground="{StaticResource TextGray}" FontSize="14" Margin="0,0,4,0"/>
                        <TextBox x:Name="StartBox" Width="60" Height="34" TextAlignment="Center" Margin="0,0,16,0" />
                        
                        <TextBlock Text="结束:" VerticalAlignment="Center" Foreground="{StaticResource TextGray}" FontSize="14" Margin="0,0,4,0"/>
                        <TextBox x:Name="EndBox" Width="60" Height="34" TextAlignment="Center" Margin="0,0,16,0" />
                        
                        <Button x:Name="DownloadBtn" Content="下载" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Height="34" />
                        <Button Content="暂停" Style="{StaticResource ModernButton}" Margin="0,0,8,0" Height="34" />
                        <Button x:Name="RetryBtn" Content="重试失败" Style="{StaticResource ModernButton}" Margin="0,0,8,0" Height="34" />
                        <Button x:Name="StopBtn" Content="停止" Style="{StaticResource ModernButton}" Height="34" />
                    </StackPanel>

                    <DataGrid x:Name="ChapterGrid" Grid.Row="1" Margin="0" 
                              SelectionMode="Extended" SelectionUnit="FullRow"
                              PreviewKeyDown="ChapterGrid_PreviewKeyDown"
                              HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="序号" Binding="{Binding Index}" Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="章节名" Binding="{Binding Title}" Width="450">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="90">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="2" Background="#F9F9F9" BorderBrush="#EEEEEE" BorderThickness="0,1,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="16,10">
                            <TextBlock Text="总数: " Foreground="{StaticResource TextGray}" FontSize="13"/>
                            <TextBlock x:Name="TotalCount" Text="0" Foreground="{StaticResource PrimaryColor}" FontWeight="Bold" FontSize="13" Margin="0,0,24,0"/>
                            <TextBlock Text="完成: " Foreground="{StaticResource TextGray}" FontSize="13"/>
                            <TextBlock x:Name="DoneCount" Text="0" Foreground="{StaticResource SuccessColor}" FontWeight="Bold" FontSize="13" Margin="0,0,24,0"/>
                            <TextBlock Text="失败: " Foreground="{StaticResource TextGray}" FontSize="13"/>
                            <TextBlock x:Name="FailCount" Text="0" Foreground="{StaticResource ErrorColor}" FontWeight="Bold" FontSize="13"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
